    <Geometry x:Key="Icon.Open">M9,3 L13,3 L13,7 M13,3 L7.5,8.5 M11,9.5 L11,13 L3,13 L3,5 L6.5,5</Geometry>
    <Geometry x:Key="Icon.Lock">M4,7.5 L12,7.5 L12,13.5 L4,13.5 Z M5.5,7.5 L5.5,5.2 A2.5,2.5 0 0 1 10.5,5.2 L10.5,7.5</Geometry>
    <Geometry x:Key="Icon.Block">M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 Z M3.8,12.2 L12.2,3.8</Geometry>
    <Geometry x:Key="Icon.In">M2,8 L10,8 M7,5 L10,8 L7,11 M13.5,3 L13.5,13</Geometry>
    <Geometry x:Key="Icon.Out">M6,8 L14,8 M11,5 L14,8 L11,11 M2.5,3 L2.5,13</Geometry>
    <Geometry x:Key="Icon.Trash">M2.5,4.5 L13.5,4.5 M6,4.5 L6,2.5 L10,2.5 L10,4.5 M4,4.5 L4.8,13.5 L11.2,13.5 L12,4.5</Geometry>

    <Style x:Key="Hue.Icon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- ================================================================== FOCUS AND WINDOW -->

    <Style x:Key="Hue.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.AccentLight}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- For items inside lists, grids and drop-downs, where an outset ring would overlap
         the neighbours. Keyboard only, like every FocusVisualStyle. -->
    <Style x:Key="Hue.FocusVisual.Inset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" CornerRadius="5" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.AccentLight}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hue.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================================================================== TEXT -->

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
    <!-- Tile title (a card that stands for one thing, e.g. "Domain" / "Private").
         Accent text so an app's tiles carry its family colour. -->
    <Style x:Key="Text.TileTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
    <!-- Section labels are written in capitals in the markup; WPF has no text-transform. -->
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
    </Style>
    <!-- The header's version line ("version 1.31.0"), right-aligned; the lines under it are Text.Caption. -->
    <Style x:Key="Text.Version" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="Padding" Value="0,0,0,6" />
    </Style>

    <!-- ================================================================== BUTTONS -->

    <ControlTemplate x:Key="Hue.ButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The glow is a blurred copy of the fill, so it follows Background. -->
    <ControlTemplate x:Key="Hue.GlowButtonTemplate" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Glow" Background="{TemplateBinding Background}" IsHitTestVisible="False"
                    CornerRadius="{StaticResource Radius.Control}" Opacity="{DynamicResource Glow.Opacity}">
                <Border.Effect>
                    <BlurEffect Radius="16" />
                </Border.Effect>
            </Border>
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Hue.Button" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Control}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource Hue.ButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Filled accent with glow. One per view: the thing the view is for. -->
    <Style x:Key="Hue.Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Template" Value="{StaticResource Hue.GlowButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentFillHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tinted accent, no glow. Secondary actions that still belong to the app's domain. -->
    <Style x:Key="Hue.Button.Tonal" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentEdge}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoftHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentEdge}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Signal buttons: show the CURRENT state of something risky (Tonal.Error while on,
         Tonal.Ok while off, Tonal.Warn for "needs care"). No glow: they come in rows. -->
    <Style x:Key="Hue.Button.Tonal.Ok" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OkText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OkEdge}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.OkSoftHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ok}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Hue.Button.Tonal.Warn" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnEdge}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.WarnSoftHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Hue.Button.Tonal.Error" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorEdge}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoftHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The header image as a button, when clicking it does something: keyboard-focusable,
         unlike an Image with a mouse handler. -->
    <Style x:Key="Hue.Button.HeaderIcon" TargetType="ButtonBase">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="Halo" Margin="6" CornerRadius="16" Background="{DynamicResource Brush.Glow}"
                                Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="22" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter x:Name="Content" RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hue.Button.Outline" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentEdge}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentEdge}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hue.Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Destructive. Deep red fill in every family: the light Brush.Error cannot carry white text. -->
    <Style x:Key="Hue.Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSolid}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnError}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Template" Value="{StaticResource Hue.GlowButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.ErrorSolidHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Square, icon only. Give it an AutomationProperties.Name and a ToolTip. -->
    <Style x:Key="Hue.Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Hue.Button.Ghost}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource Size.Control}" />
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Hue.Button}" />
    <Style TargetType="RepeatButton" BasedOn="{StaticResource Hue.Button}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Hue.Button}">
        <Style.Triggers>
            <!-- The accent edge, not the soft one: the on state must stand out at 3:1. -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================== SCROLLING -->

    <Style x:Key="Hue.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Margin="3" CornerRadius="4" Background="{DynamicResource Brush.ControlEdge}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource Brush.TextDim}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hue.ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Hue.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Hue.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Hue.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="14" />
                <Setter Property="MinHeight" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Hue.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Hue.ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Hue.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Replaced so the corner between two scroll bars is not the system's light grey. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== TEXT INPUT
         Inputs sit on Base, one step darker than the card they are on, so they read as inset.
         Focus is the accent border; inputs do not glow. -->

    <ControlTemplate x:Key="Hue.InputTemplate" TargetType="Control">
        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentLight}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Hue.InputTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Hue.InputTemplate}" />
    </Style>

    <!-- ================================================================== CHECK, RADIO, SWITCH -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlEdge}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <Path x:Name="Mark" Data="M1,5 L4.5,8.5 L11,1.5" Visibility="Collapsed"
                                      Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle x:Name="Dash" Width="8" Height="2" RadiusX="1" RadiusY="1" Visibility="Collapsed"
                                           Fill="{DynamicResource Brush.OnAccent}" />
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentLight}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentFill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentFill}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentFill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentFill}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlEdge}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" StrokeThickness="1.5"
                                     Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Visibility="Collapsed"
                                     Fill="{DynamicResource Brush.Accent}" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.AccentLight}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preference switch (CheckBox / ToggleButton). On is green in every family; off is
         neutral, because an ordinary "off" is not a problem. Three-way settings: use HueSwitch,
         since a plain three-state toggle cycles off, on, not set. -->
    <Style x:Key="Hue.Switch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" BorderThickness="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Hover}" BorderBrush="{DynamicResource Brush.ControlEdge}">
                            <Grid>
                                <Ellipse x:Name="KnobGlow" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource Brush.Ok}" Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="9" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource Brush.TextDim}" />
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.AccentLight}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.OkSoft}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Ok}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.OkText}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="KnobGlow" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="KnobGlow" Property="Opacity" Value="{DynamicResource Glow.Opacity}" />
                        </Trigger>
                        <!-- Not set: centred and hollow, so it reads as neither side. -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.Surface}" />
                            <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource Brush.TextDim}" />
                            <Setter TargetName="Knob" Property="StrokeThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Signal switches: colour = what the state means (green safe, red unsafe, amber unset),
         in every family. Pick by which side is safe: SafeWhenOn / SafeWhenOff. The styles drive
         the colours through Tag; don't set Tag yourself. -->
    <Style x:Key="Hue.Switch.Signal" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" BorderThickness="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Hover}" BorderBrush="{DynamicResource Brush.ControlEdge}">
                            <Grid>
                                <Ellipse x:Name="KnobGlow" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource Brush.Ok}" Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="9" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource Brush.TextDim}" />
                            </Grid>
                        </Border>
                        <!-- Reserves the width of "Not configured" so the tile keeps its size in every state. -->
                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextBlock Text="Not configured" Visibility="Hidden" />
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Position: what the switch is set to. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="KnobGlow" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="KnobGlow" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>
                        <!-- Colour: what that setting means. -->
                        <Trigger Property="Tag" Value="Safe">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.OkSoft}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Ok}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.OkText}" />
                            <Setter TargetName="KnobGlow" Property="Fill" Value="{DynamicResource Brush.Ok}" />
                            <Setter TargetName="KnobGlow" Property="Opacity" Value="{DynamicResource Glow.Opacity}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Unsafe">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.ErrorText}" />
                            <Setter TargetName="KnobGlow" Property="Fill" Value="{DynamicResource Brush.Error}" />
                            <Setter TargetName="KnobGlow" Property="Opacity" Value="{DynamicResource Glow.Opacity}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Unset">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
                            <Setter TargetName="Knob" Property="Fill" Value="Transparent" />
                            <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource Brush.WarnText}" />
                            <Setter TargetName="Knob" Property="StrokeThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hue.Switch.SafeWhenOn" TargetType="ToggleButton" BasedOn="{StaticResource Hue.Switch.Signal}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Tag" Value="Safe" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Tag" Value="Unsafe" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter Property="Tag" Value="Unset" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hue.Switch.SafeWhenOff" TargetType="ToggleButton" BasedOn="{StaticResource Hue.Switch.Signal}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Tag" Value="Unsafe" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Tag" Value="Safe" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter Property="Tag" Value="Unset" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================== COMBOBOX -->

    <Style x:Key="Hue.ComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hue.ComboEditBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The panel behind every popup: menus, context menus, drop-downs. The margin leaves
         room for the shadow inside the popup's transparent window. -->
    <Style x:Key="Hue.PopupPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual.Inset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius.Item}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="SelectionBar" Width="3" Margin="0,6" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0,34,0" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}" />
                        <ToggleButton x:Name="Toggle" Style="{StaticResource Hue.ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource Hue.ComboEditBox}"
                                 Visibility="Hidden" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Path x:Name="Arrow" Data="M0,0 L4,4 L8,0" IsHitTestVisible="False"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                              Stroke="{DynamicResource Brush.TextDim}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Style="{StaticResource Hue.PopupPanel}"
                                    MinWidth="{Binding ActualWidth, ElementName=Bd}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentLight}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentLight}" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Brush.AccentLight}" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            <Setter Property="Cursor" Value="IBeam" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== SLIDER -->

    <Style x:Key="Hue.SliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18" Background="Transparent">
                        <Ellipse Fill="{DynamicResource Brush.Glow}" Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Knob" Fill="{DynamicResource Brush.Accent}"
                                 Stroke="{DynamicResource Brush.Base}" StrokeThickness="3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.AccentMid}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.AccentLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hue.SliderBar" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Brush.LineStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Vertical">
                            <Setter TargetName="Bar" Property="Height" Value="Auto" />
                            <Setter TargetName="Bar" Property="Width" Value="4" />
                            <Setter TargetName="Bar" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="Bar" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid MinHeight="24" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Hue.SliderBar}" Background="{DynamicResource Brush.Accent}"
                                              Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Hue.SliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Hue.SliderBar}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid MinWidth="24" Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Hue.SliderBar}" Tag="Vertical"
                                                      Background="{DynamicResource Brush.Accent}" Command="Slider.DecreaseLarge" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Hue.SliderThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Hue.SliderBar}" Tag="Vertical" Command="Slider.IncreaseLarge" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================== PROGRESS
         Tag="Glow" makes the indicator glow in its own Foreground: for the one bar a view is
         about, not for bars repeated in list or grid rows. -->

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                            <Border x:Name="IndicatorGlow" CornerRadius="3" Background="{TemplateBinding Foreground}"
                                    Visibility="Collapsed" Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="8" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="3" Background="{TemplateBinding Foreground}" />
                        </Grid>
                        <Border x:Name="Sweep" CornerRadius="3" Visibility="Collapsed"
                                Background="{TemplateBinding Foreground}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-1" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Offset="0.15" Color="Transparent" />
                                    <GradientStop Offset="0.5" Color="Black" />
                                    <GradientStop Offset="0.85" Color="Transparent" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Glow">
                            <Setter TargetName="IndicatorGlow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SweepRun">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Sweep"
                                                         Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-1" To="1" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SweepRun" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== LISTS -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Card}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual.Inset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius.Item}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="SelectionBar" Width="3" Margin="0,6" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Raised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== TREE -->

    <Style x:Key="Hue.TreeExpander" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" RenderTransformOrigin="0.5,0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                      CanContentScroll="False" HorizontalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="4,0,10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Grid>
                            <Border x:Name="Bd" MinHeight="30" Background="Transparent" CornerRadius="{StaticResource Radius.Item}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Style="{StaticResource Hue.TreeExpander}" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" Margin="4,0,0,0"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                            <Border x:Name="SelectionBar" Width="3" Margin="0,6" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Raised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Header" Property="TextElement.Foreground" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== TABS
         Underline tabs. The selected tab's line glows. -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,16,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1"
                                      KeyboardNavigation.TabIndex="1" Background="Transparent" />
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Background="Transparent" Margin="0,0,4,0">
                        <ContentPresenter x:Name="Content" ContentSource="Header" Margin="14,9,14,11"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        <Border x:Name="LineGlow" Height="3" Margin="10,0" VerticalAlignment="Bottom" CornerRadius="1.5"
                                Background="{DynamicResource Brush.Glow}" Opacity="0" IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="7" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Line" Height="2" Margin="10,0" VerticalAlignment="Bottom" CornerRadius="1"
                                Background="{DynamicResource Brush.Accent}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LineGlow" Property="Opacity" Value="{DynamicResource Glow.Opacity}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== DATAGRID
         Horizontal rules only, column headers only. Wrap it in Hue.Card or give it the
         default Surface background. -->

    <Style x:Key="Hue.HeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <!-- Compact rows for logs: 28 px, still above the 24 px target minimum. -->
    <Style x:Key="Hue.DataGrid.Compact" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Chrome}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Path x:Name="SortArrow" Grid.Column="1" Visibility="Collapsed" Margin="6,0,0,0"
                                      Data="M0,0 L4,4 L8,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                      Stroke="{DynamicResource Brush.AccentLight}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource Hue.HeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Hue.HeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Data" Value="M0,4 L4,0 L8,4" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The row's own border draws the selection bar: 3 px on the left, transparent until
         selected, so nothing shifts when it appears. -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual.Inset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================== MENUS -->

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{DynamicResource Brush.Line}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,8" Background="{DynamicResource Brush.LineSoft}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Brush.Chrome}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One template for every role. Top-level items drop their icon and arrow columns
         and open downwards; submenu headers show an arrow and open to the right. -->
    <ControlTemplate x:Key="Hue.MenuItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius.Item}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="IconSlot" Width="26">
                    <ContentPresenter x:Name="IconHost" ContentSource="Icon" Width="16" Height="16"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Path x:Name="Check" Data="M0,4.5 L3.5,8 L10,0.5" Visibility="Collapsed"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                          Stroke="{DynamicResource Brush.AccentLight}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Grid>
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <TextBlock x:Name="Gesture" Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center"
                           Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" />
                <Grid x:Name="ArrowSlot" Grid.Column="3" Width="18">
                    <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" Visibility="Collapsed"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Grid>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="6" VerticalOffset="-5"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Style="{StaticResource Hue.PopupPanel}" MinWidth="200"
                            TextElement.Foreground="{DynamicResource Brush.Text}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ArrowSlot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-4" />
                <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="4" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ArrowSlot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="8,6,10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource Hue.MenuItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Padding" Value="10,5" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Padding" Value="10,5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Style="{StaticResource Hue.PopupPanel}" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}" MaxWidth="360" SnapsToDevicePixels="True">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== EXPANDER, GROUPBOX -->

    <Style x:Key="Hue.ExpanderHeader" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" RenderTransformOrigin="0.5,0.5"
                                  VerticalAlignment="Center" Margin="2,0,0,0"
                                  Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Raised}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Brush.AccentLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Card}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Margin="4" Style="{StaticResource Hue.ExpanderHeader}"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ExpandSite" Margin="18,2,18,16" Visibility="Collapsed" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Card}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" Margin="0,0,0,12" ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.Foreground="{DynamicResource Brush.TextMuted}"
                                              TextElement.FontSize="11" TextElement.FontWeight="SemiBold" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== SUITE LAYOUT -->

    <Style x:Key="Hue.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The header block: identity left (app_256.png in Hue.IconGlow, app name in Text.Title, one
         line in Text.Body), live time and status pills dead centre, info blocks, the version
         block (Text.Version) and header actions right. Columns *, Auto, * keep the centre centred. -->
    <Style x:Key="Hue.Header" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Chrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,16" />
    </Style>

    <Style x:Key="Hue.StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Chrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextDim}" />
    </Style>

    <Style x:Key="Hue.Divider" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.LineSoft}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="20,4" />
    </Style>

    <!-- Side navigation. Use RadioButtons in one GroupName; the active item's marker glows. -->
    <Style x:Key="Hue.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Height="38" Padding="12,0" Background="Transparent"
                            CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse x:Name="MarkerGlow" Width="12" Height="12" Margin="-2" Opacity="0"
                                         Fill="{DynamicResource Brush.Glow}" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="Marker" Fill="{DynamicResource Brush.LineStrong}" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Raised}" />
                            <Setter TargetName="Marker" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="MarkerGlow" Property="Opacity" Value="{DynamicResource Glow.Opacity}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A colour choice. Background is the colour; the chosen one gets a ring and a glow. -->
    <Style x:Key="Hue.Swatch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Glow" Width="18" Height="18" Opacity="0" Fill="{TemplateBinding Background}" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <BlurEffect Radius="10" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Ring" StrokeThickness="2" Opacity="0" Stroke="{DynamicResource Brush.Text}" />
                        <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter TargetName="Glow" Property="Opacity" Value="{DynamicResource Glow.Opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The app_256.png header image, with a halo in the family colour behind it. -->
    <Style x:Key="Hue.IconGlow" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="6" CornerRadius="16" Background="{DynamicResource Brush.Glow}"
                                Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="22" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== FEEDBACK -->

    <!-- Callouts: Foreground is the title and marker colour, Background the fill, BorderBrush the edge. -->
    <ControlTemplate x:Key="Hue.CalloutTemplate" TargetType="ContentControl">
        <Grid>
            <Border x:Name="Halo" CornerRadius="{StaticResource Radius.Card}" BorderThickness="3" Visibility="Collapsed"
                    BorderBrush="{TemplateBinding Foreground}" Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                <Border.Effect>
                    <BlurEffect Radius="18" />
                </Border.Effect>
            </Border>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="10" Height="10" Margin="0,5,14,0" VerticalAlignment="Top">
                        <Ellipse x:Name="DotGlow" Width="14" Height="14" Margin="-2" Visibility="Collapsed"
                                 Fill="{TemplateBinding Foreground}" Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Fill="{TemplateBinding Foreground}" />
                    </Grid>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Glow">
                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                <Setter TargetName="DotGlow" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Hue.Callout" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentEdge}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Template" Value="{StaticResource Hue.CalloutTemplate}" />
    </Style>

    <!-- Something needs attention. Status red with a halo, in every family. -->
    <Style x:Key="Hue.Callout.Critical" TargetType="ContentControl" BasedOn="{StaticResource Hue.Callout}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorEdge}" />
        <Setter Property="Tag" Value="Glow" />
    </Style>

    <Style x:Key="Hue.Callout.Ok" TargetType="ContentControl" BasedOn="{StaticResource Hue.Callout}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OkText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OkEdge}" />
    </Style>

    <Style x:Key="Hue.Callout.Warn" TargetType="ContentControl" BasedOn="{StaticResource Hue.Callout}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnEdge}" />
    </Style>

    <!-- Pills: status ("how it went"). Tag="Glow" only on a single standalone pill: every glow
         is a blur, and repeated rows of them stutter over Remote Desktop. -->
    <ControlTemplate x:Key="Hue.PillTemplate" TargetType="ContentControl">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="11" Height="22" Padding="8,0,10,0"
                HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <Grid Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Ellipse x:Name="DotGlow" Width="10" Height="10" Margin="-2" Visibility="Collapsed"
                             Fill="{TemplateBinding Foreground}" Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <BlurEffect Radius="6" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Fill="{TemplateBinding Foreground}" />
                </Grid>
                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12" TextElement.FontWeight="Medium" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Glow">
                <Setter TargetName="DotGlow" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Hue.Pill" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="Template" Value="{StaticResource Hue.PillTemplate}" />
    </Style>
    <Style x:Key="Hue.Pill.Accent" TargetType="ContentControl" BasedOn="{StaticResource Hue.Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentEdge}" />
    </Style>
    <Style x:Key="Hue.Pill.Ok" TargetType="ContentControl" BasedOn="{StaticResource Hue.Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OkText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OkEdge}" />
    </Style>
    <Style x:Key="Hue.Pill.Warn" TargetType="ContentControl" BasedOn="{StaticResource Hue.Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnEdge}" />
    </Style>
    <Style x:Key="Hue.Pill.Limit" TargetType="ContentControl" BasedOn="{StaticResource Hue.Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.LimitText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.LimitSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LimitEdge}" />
    </Style>
    <Style x:Key="Hue.Pill.Error" TargetType="ContentControl" BasedOn="{StaticResource Hue.Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorEdge}" />
    </Style>
    <Style x:Key="Hue.Pill.Stale" TargetType="ContentControl" BasedOn="{StaticResource Hue.Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.StaleText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.StaleSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StaleEdge}" />
    </Style>

    <!-- Tags: category ("which kind"). Squarer, no dot, so they never read as status pills.
         Signal tags only where the category carries real risk; otherwise colour reads as a
         verdict that isn't there. -->
    <Style x:Key="Hue.Tag" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5" MinHeight="22" Padding="7,1,8,1"
                            HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12" TextElement.FontWeight="Medium" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hue.Tag.Accent" TargetType="ContentControl" BasedOn="{StaticResource Hue.Tag}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentEdge}" />
    </Style>
    <Style x:Key="Hue.Tag.Safe" TargetType="ContentControl" BasedOn="{StaticResource Hue.Tag}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OkText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OkEdge}" />
    </Style>
    <Style x:Key="Hue.Tag.Caution" TargetType="ContentControl" BasedOn="{StaticResource Hue.Tag}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnEdge}" />
    </Style>
    <Style x:Key="Hue.Tag.Unsafe" TargetType="ContentControl" BasedOn="{StaticResource Hue.Tag}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorEdge}" />
    </Style>

    <!-- HTTP status chips. Tag="Glow" only on a single standalone chip, never in rows. -->
    <ControlTemplate x:Key="Hue.CodeTemplate" TargetType="ContentControl">
        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border x:Name="Halo" CornerRadius="10" BorderThickness="3" Visibility="Collapsed"
                    BorderBrush="{TemplateBinding BorderBrush}" Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                <Border.Effect>
                    <BlurEffect Radius="12" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="10" BorderThickness="2" Padding="12,3,12,4"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                <ContentPresenter TextElement.FontFamily="{StaticResource Font.Mono}" TextElement.FontSize="17"
                                  TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding BorderBrush}" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Glow">
                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Hue.Code.Ok" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OkText}" />
        <Setter Property="Template" Value="{StaticResource Hue.CodeTemplate}" />
    </Style>
    <Style x:Key="Hue.Code.Info" TargetType="ContentControl" BasedOn="{StaticResource Hue.Code.Ok}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
    </Style>
    <Style x:Key="Hue.Code.Limit" TargetType="ContentControl" BasedOn="{StaticResource Hue.Code.Ok}">
        <Setter Property="Background" Value="{DynamicResource Brush.LimitSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LimitText}" />
    </Style>
    <Style x:Key="Hue.Code.Error" TargetType="ContentControl" BasedOn="{StaticResource Hue.Code.Ok}">
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorText}" />
    </Style>

    <!-- Timestamp chips: current, aged, old. -->
    <ControlTemplate x:Key="Hue.StampTemplate" TargetType="ContentControl">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="8,4,10,4"
                HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Clock}" Width="16" Height="16" VerticalAlignment="Center"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                  TextElement.FontFamily="{StaticResource Font.Mono}" TextElement.FontSize="12" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <Style x:Key="Hue.Stamp.Current" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OkText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OkEdge}" />
        <Setter Property="Template" Value="{StaticResource Hue.StampTemplate}" />
    </Style>
    <Style x:Key="Hue.Stamp.Aged" TargetType="ContentControl" BasedOn="{StaticResource Hue.Stamp.Current}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnEdge}" />
    </Style>
    <Style x:Key="Hue.Stamp.Old" TargetType="ContentControl" BasedOn="{StaticResource Hue.Stamp.Current}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.StaleText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.StaleSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StaleEdge}" />
    </Style>

    <!-- Marker dots. Foreground is the colour. -->
    <Style x:Key="Hue.Marker" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="8" Height="8">
                        <Ellipse x:Name="DotGlow" Width="12" Height="12" Margin="-2" Visibility="Collapsed"
                                 Fill="{TemplateBinding Foreground}" Opacity="{DynamicResource Glow.Opacity}" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Fill="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Glow">
                            <Setter TargetName="DotGlow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hue.Marker.Glow" TargetType="ContentControl" BasedOn="{StaticResource Hue.Marker}">
        <Setter Property="Tag" Value="Glow" />
    </Style>

    <!-- ================================================================== WINDOWS
         Applies to plain Window instances (dialogs created in code). Your own window classes
         need Style="{StaticResource Hue.Window}". -->
    <Style TargetType="Window" BasedOn="{StaticResource Hue.Window}" />

</ResourceDictionary>
