    <LinearGradientBrush x:Key="Busy.Ring" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="{StaticResource Cyan.Light}" />
        <GradientStop Offset="0.5" Color="{StaticResource Cyan.Mid}" />
        <GradientStop Offset="1"   Color="{StaticResource Cyan.Base}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Busy.RingAccent" StartPoint="1,0" EndPoint="0,1">
