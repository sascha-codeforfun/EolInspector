        <GradientStop Offset="0.55" Color="{StaticResource Cyan.Mid}" />
        <GradientStop Offset="1"    Color="{StaticResource Cyan.Base}" />
    </LinearGradientBrush>

    <!-- How strongly glows show, 0 to 1. -->
    <sys:Double x:Key="Glow.Opacity">0.35</sys:Double>

