<Window x:Class="EolInspector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="EOL Inspector" Height="720" Width="1040"
        MinHeight="420" MinWidth="720"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Grid cells. Colours come from the theme; never a hex value here. -->

        <!-- EOL cell: bold, monospace, coloured by value. Mixed is the one to fix, so it's red. -->
        <Style x:Key="EolCellStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Eol}" Value="Mixed">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Eol}" Value="LF">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Eol}" Value="CR">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Eol}" Value="None">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Count columns: muted when zero so real counts stand out. -->
        <Style x:Key="CountCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Right-aligned cell: sizes read better flush right. -->
        <Style x:Key="RightCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <Style x:Key="RightHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!-- BOM cell: muted when absent ("None"), so files that carry a BOM stand out. -->
        <Style x:Key="BomCellStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bom}" Value="None">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The labels in front of the option boxes, one column wide so the boxes line up. -->
        <Style x:Key="OptionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header  -->
            <RowDefinition Height="Auto" />  <!-- options -->
            <RowDefinition Height="*" />     <!-- results -->
            <RowDefinition Height="Auto" />  <!-- status  -->
        </Grid.RowDefinitions>

        <!-- Header: icon, name and description on the left; version, SDK and runtime on the right. -->
        <Border Grid.Row="0" Style="{StaticResource Hue.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <ContentControl Style="{StaticResource Hue.IconGlow}" Width="64" Height="64">
                        <Image Source="pack://application:,,,/app_256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </ContentControl>
                    <StackPanel Margin="18,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="EOL Inspector" Style="{StaticResource Text.Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Shows the line-ending style and byte-order mark of every text file in a folder."
                                   Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Version}" />
                    <TextBlock x:Name="SdkText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="RuntimeText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- What to scan: the folder, then the two filters. Labels share a column so the boxes line up. -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Folder" Style="{StaticResource OptionLabel}" />
                <TextBox x:Name="FolderBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                         Text="No folder selected" AutomationProperties.Name="Folder"
                         ToolTip="The folder to scan. Pick it with Pick folder." />
                <CheckBox x:Name="RecurseCheck" Grid.Row="0" Grid.Column="2" Content="Include subfolders"
                          Margin="14,0,0,0" VerticalAlignment="Center"
                          Checked="RecurseCheck_Changed" Unchecked="RecurseCheck_Changed"
                          ToolTip="Off scans only the top level of the folder; on walks the whole tree." />
                <Button x:Name="PickButton" Grid.Row="0" Grid.Column="3" Content="Pick folder…"
                        Margin="14,0,0,0" MinWidth="120" Click="PickButton_Click" />

                <TextBlock Grid.Row="1" Text="Extensions" Style="{StaticResource OptionLabel}" Margin="0,10,14,0" />
                <TextBox x:Name="ExtBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                         AutomationProperties.Name="Extensions"
                         ToolTip="Comma-separated; the leading dot is optional and case doesn't matter. Empty scans every file." />
                <Button x:Name="ResetExtButton" Grid.Row="1" Grid.Column="2" Content="Reset" Margin="14,10,0,0"
                        HorizontalAlignment="Left" ToolTip="Restore the default extension list" Click="ResetExtButton_Click" />
                <Button x:Name="ScanButton" Grid.Row="1" Grid.Column="3" Content="Scan" Margin="14,10,0,0"
                        MinWidth="120" Style="{StaticResource Hue.Button.Primary}" IsEnabled="False"
                        Click="ScanButton_Click" />

                <TextBlock x:Name="ExcludeLabel" Grid.Row="2" Text="Exclude folders" Style="{StaticResource OptionLabel}"
                           Margin="0,10,14,0" />
                <TextBox x:Name="ExcludeBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                         AutomationProperties.Name="Exclude folders"
                         ToolTip="Comma-separated folder names (not paths), skipped with everything beneath them. Only used with Include subfolders. Empty excludes nothing." />
                <Button x:Name="ResetExcludeButton" Grid.Row="2" Grid.Column="2" Content="Reset" Margin="14,10,0,0"
                        HorizontalAlignment="Left" ToolTip="Restore the default excluded-folder list" Click="ResetExcludeButton_Click" />
            </Grid>
        </Border>

        <!-- Results, with the scan's progress beneath while it runs. -->
        <Grid Grid.Row="2" Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="ResultsGrid" Style="{StaticResource Hue.DataGrid.Compact}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                      SelectionMode="Extended" EnableRowVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                      AutomationProperties.Name="Results"
                      ToolTip="Double-click a file to open it with the app you choose.">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*" />
                    <DataGridTextColumn Header="BOM" Binding="{Binding Bom}" Width="110"
                                        ElementStyle="{StaticResource BomCellStyle}" />
                    <DataGridTextColumn Header="EOL style" Binding="{Binding Eol}" Width="120"
                                        ElementStyle="{StaticResource EolCellStyle}" />
                    <DataGridTextColumn Header="CRLF" Binding="{Binding CrlfCount}" Width="80"
                                        ElementStyle="{StaticResource CountCellStyle}" />
                    <DataGridTextColumn Header="LF" Binding="{Binding LfCount}" Width="80"
                                        ElementStyle="{StaticResource CountCellStyle}" />
                    <DataGridTextColumn Header="CR" Binding="{Binding CrCount}" Width="80"
                                        ElementStyle="{StaticResource CountCellStyle}" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="130"
                                        SortMemberPath="SizeBytes"
                                        ElementStyle="{StaticResource RightCellStyle}"
                                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Shown only while a scan is running. -->
            <ProgressBar x:Name="ScanProgressBar" Grid.Row="1" Minimum="0" Value="0"
                         Visibility="Collapsed" Margin="0,12,0,0" AutomationProperties.Name="Scan progress" />
        </Grid>

        <!-- Status: a dot and a line of text. -->
        <Border Grid.Row="3" Style="{StaticResource Hue.StatusBar}">
            <StackPanel Orientation="Horizontal">
                <ContentControl x:Name="StatusDot" Style="{StaticResource Hue.Marker}"
                                Foreground="{DynamicResource Brush.Stale}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="Ready." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
