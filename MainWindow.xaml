<Window x:Class="EolInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EOL Inspector" Height="620" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        TextElement.Foreground="#FFDCDCDC"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ===== Visual Studio dark palette ===== -->
        <SolidColorBrush x:Key="WindowBg"        Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="PanelBg"         Color="#FF252526"/>
        <SolidColorBrush x:Key="ControlBg"       Color="#FF333337"/>
        <SolidColorBrush x:Key="ControlBgHover"  Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="ControlBgActive" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="BorderBrush"     Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderHover"     Color="#FF007ACC"/>
        <SolidColorBrush x:Key="TextBrush"       Color="#FFDCDCDC"/>
        <SolidColorBrush x:Key="TextMuted"       Color="#FF9D9D9D"/>
        <SolidColorBrush x:Key="GridLineBrush"   Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="HeaderBg"        Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="RowAltBg"        Color="#FF252526"/>
        <SolidColorBrush x:Key="SelectionBg"     Color="#FF094771"/>

        <!-- EOL semantic colors -->
        <SolidColorBrush x:Key="EolMixed" Color="#FFF14C4C"/>
        <SolidColorBrush x:Key="EolCrlf"  Color="#FFE5C07B"/>
        <SolidColorBrush x:Key="EolLf"    Color="#FF89D185"/>
        <SolidColorBrush x:Key="EolCr"    Color="#FFD7A0FF"/>

        <!-- ===== TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Button ===== -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBgHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBgActive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== CheckBox ===== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== TextBlock (labels) ===== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- ===== DataGrid ===== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource PanelBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAltBg}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="RowHeight" Value="26"/>
        </Style>

        <!-- Column headers -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Cells: base style + selection color -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBg}"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- EOL cell: bold, monospace, colored by value via DataTriggers. -->
        <Style x:Key="EolCellStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Eol}" Value="Mixed">
                    <Setter Property="Foreground" Value="{StaticResource EolMixed}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Eol}" Value="CRLF">
                    <Setter Property="Foreground" Value="{StaticResource EolCrlf}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Eol}" Value="LF">
                    <Setter Property="Foreground" Value="{StaticResource EolLf}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Eol}" Value="CR">
                    <Setter Property="Foreground" Value="{StaticResource EolCr}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Eol}" Value="None">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Numeric count columns: muted when zero so real counts stand out -->
        <Style x:Key="CountCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Top bar: folder picker + options -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FolderBox" Grid.Column="0"
                     IsReadOnly="True"
                     Text="No folder selected"/>

            <CheckBox x:Name="RecurseCheck" Grid.Column="1"
                      Content="Include subfolders"
                      VerticalAlignment="Center"
                      Margin="12,0"
                      Checked="RecurseCheck_Changed"
                      Unchecked="RecurseCheck_Changed"/>

            <Button x:Name="PickButton" Grid.Column="2"
                    Content="Pick Folder…"
                    Click="PickButton_Click"/>
        </Grid>

        <!-- Extension filter bar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Extensions (comma-separated, blank = all):"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="ExtBox" Grid.Column="1"/>
            <Button x:Name="ResetExtButton" Grid.Column="2"
                    Content="Reset" Margin="8,0,0,0"
                    ToolTip="Restore the default extension list"
                    Click="ResetExtButton_Click"/>
            <Button x:Name="ScanButton" Grid.Column="3"
                    Content="Scan" Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="ScanButton_Click"/>
        </Grid>

        <!-- Folder exclusion bar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ExcludeLabel" Grid.Column="0"
                       Text="Exclude folders (comma-separated, blank = none):"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="ExcludeBox" Grid.Column="1"/>
            <Button x:Name="ResetExcludeButton" Grid.Column="2"
                    Content="Reset" Margin="8,0,0,0"
                    ToolTip="Restore the default excluded-folder list"
                    Click="ResetExcludeButton_Click"/>
        </Grid>

        <!-- Status bar at the very bottom -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ControlBgActive}"
                Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Ready."
                       Foreground="#FFFFFFFF"
                       Padding="8,4"/>
        </Border>

        <!-- Results grid -->
        <DataGrid x:Name="ResultsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*"/>
                <DataGridTextColumn Header="EOL Style" Binding="{Binding Eol}" Width="120"
                                    ElementStyle="{StaticResource EolCellStyle}"/>
                <DataGridTextColumn Header="CRLF" Binding="{Binding CrlfCount}" Width="75"
                                    ElementStyle="{StaticResource CountCellStyle}"/>
                <DataGridTextColumn Header="LF" Binding="{Binding LfCount}" Width="75"
                                    ElementStyle="{StaticResource CountCellStyle}"/>
                <DataGridTextColumn Header="CR" Binding="{Binding CrCount}" Width="75"
                                    ElementStyle="{StaticResource CountCellStyle}"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="95"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
